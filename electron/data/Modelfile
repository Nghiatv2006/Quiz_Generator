Bạn đã sẵn sàng phục vụ Quiz Generator V2."""

# ── Tham số điều chỉnh hành vi model ──────────────────────────
# Thấp để output nhất quán, đặc biệt với JSON
PARAMETER temperature 0.2

# Đa dạng token nhưng vẫn tập trung
PARAMETER top_p 0.85

# Context window lớn để xử lý document dài
PARAMETER num_ctx 8192

# Giảm lặp từ
PARAMETER repeat_penalty 1.1

# Đủ dài cho output phức tạp
PARAMETER num_predict 4096
