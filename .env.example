# ============================================================
# QUIZ GENERATOR V2 - Environment Variables (Example)
# ============================================================

# Database - SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=your_password_here
DB_NAME=quiz_generator

# Gemini AI
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Google AI Studio model config
# Recommended for free tier
GEMINI_MODEL_TEXT=gemini-1.5-flash
GEMINI_MODEL_CHAT=gemini-1.5-flash
GEMINI_MODEL_VISION=gemini-1.5-flash
# Fallback chain when primary model has temporary issue/quota hit (avoid deprecated models)
GEMINI_FALLBACK_MODELS=gemini-1.5-flash


# AI Provider (Dual: ollama + gemini)
AI_PROVIDER_DEFAULT=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_TEXT=llama3.1:8b
OLLAMA_MODEL_CHAT=llama3.1:8b
OLLAMA_MODEL_VISION=llava:7b
# JWT
JWT_SECRET=change_this_to_a_strong_secret
JWT_EXPIRES_IN=7d

# App
NODE_ENV=development
APP_PORT=3000
